{
  "name": "local-recorder",
  "version": "1.7.23",
  "private": true,
  "description": "Grabadora de pantalla local para Windows",
  "author": "Tomixel",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:area": "node tests/area.mjs",
    "test:editing": "node tests/editing.mjs",
    "test:transitions": "node tests/window-transitions.mjs",
    "package:win": "npm run build && node scripts/package.mjs nsis",
    "package:dir": "npm run build && node scripts/package.mjs dir"
  },
  "build": {
    "appId": "local.recorder.desktop",
    "productName": "Tomixel",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "ffmpeg-static": "^5.3.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "34.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
